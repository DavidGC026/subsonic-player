<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_surface_pill"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Por Qué Te Vas"
                android:textColor="@color/widget_on_surface"
                android:textSize="15.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="TINI, Cali Y El Dandee"
                android:textColor="@color/widget_on_surface"
                android:textSize="12.5sp" />

            <ProgressBar
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:id="@+id/widget_progress"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progress="55"
            android:progressDrawable="@drawable/widget_progress_yellow" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_controls_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/widget_btn_prev"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/widget_tonal_button"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_media_previous"
                android:tint="@color/widget_on_surface" />

            <ImageButton
                android:id="@+id/widget_btn_play"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/widget_primary_button"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_media_play"
                android:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/widget_btn_next"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/widget_tonal_button"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_media_next"
                android:tint="@color/widget_on_surface" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
